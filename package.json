{
  "name": "luxstage-desktop",
  "version": "2026.10.7",
  "description": "LuxStage Desktop – Hülle um die Web-App, Träger für den Pult-Sync",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/dev-name.js && electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "node --test test/eos-sync.test.js"
  },
  "build": {
    "appId": "app.luxstage.desktop",
    "productName": "LuxStage",
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Plobli",
        "repo": "luxstage-desktop",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "sign": true
    },
    "afterAllArtifactBuild": "scripts/notarize-dmg.js",
    "appx": {
      "identityName": "ChristopherRohde.LuxStage",
      "publisher": "CN=D7944E62-BCF9-486E-B729-E00B98A0352F",
      "publisherDisplayName": "Christopher Rohde",
      "applicationId": "LuxStage",
      "displayName": "LuxStage",
      "languages": [
        "de-DE",
        "en-US"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "Christopher Rohde",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
