{
  "name": "luxstage-desktop",
  "version": "0.1.0",
  "description": "LuxStage Desktop – Hülle um die Web-App, Träger für den Pult-Sync",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "prestart": "node scripts/dev-name.js"
  },
  "build": {
    "appId": "app.luxstage.desktop",
    "productName": "LuxStage",
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
